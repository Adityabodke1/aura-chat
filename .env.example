# ---------------------------------------------------------------------------
#  Aura Chat server configuration
#  Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# Port for the Express + Socket.IO server.
PORT=3001

# Supabase project URL (Project Settings → API).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# SERVER-ONLY secret key. Never put this in client code or commit it.
# Project Settings → API Keys → Secret keys → create/copy "sb_secret_…".
# The legacy "service_role" JWT also works.
SUPABASE_SECRET_KEY=

# Public Storage bucket used for chat attachments.
SUPABASE_STORAGE_BUCKET=aura-uploads

# Optional: set to "json" to force the local data/db.json fallback even when
# Supabase is configured (useful for offline development).
# AURA_STORE=json

# Browser origin(s) allowed to call this API directly. Required when the client
# is hosted separately (for example Netlify). Comma-separated for previews.
# A * wildcard is supported for subdomains.
# Example: CLIENT_ORIGIN=https://aura-chat.netlify.app
# Example: CLIENT_ORIGIN=https://*.netlify.app
CLIENT_ORIGIN=

# ---------------------------------------------------------------------------
#  Client build-time configuration (also set these in Netlify)
#  Leave both blank for local development or when Express serves dist/ itself.
#  Vite only exposes variables prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------
# VITE_API_URL=https://YOUR-SERVICE.onrender.com
# VITE_SOCKET_URL=https://YOUR-SERVICE.onrender.com
