{
  "name": "aura-chat",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Aura Chat — Discord-inspired chat app with OTP rooms, media messages, voice and video calls.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"node server/index.js\" \"vite --config client/vite.config.js\"",
    "client": "vite --config client/vite.config.js",
    "server": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "db:check": "node scripts/check-supabase.mjs",
    "db:migrate": "node scripts/migrate-to-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.0.1",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.6"
  }
}
